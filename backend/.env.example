# Environment Variables Template
PORT=5555
MONGODB_URI=mongodb://127.0.0.1:27017/books-collection
# Free Welcome Email Configuration (Gmail SMTP - 500 emails/day free)
# 1. Turn on 2-Step Verification in Google Account -> Security
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Add your Gmail and 16-character app password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
JWT_SECRET=your_jwt_secret_key_here

